# ===== Postgres =====
POSTGRES_USER=medboard
POSTGRES_PASSWORD=medboard
POSTGRES_DB=medboard
POSTGRES_PORT=5432

# ===== Redis =====
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== API (NestJS) =====
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL=postgresql://medboard:medboard@localhost:5432/medboard?schema=public
REDIS_URL=redis://localhost:6379

# ===== Web (Next.js) =====
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Optional override for GraphQL subscriptions (derived from API_URL when unset)
# NEXT_PUBLIC_API_WS_URL=ws://localhost:3001/graphql

# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_JWT_SECRET=<jwt-secret>
SUPABASE_WEBHOOK_SECRET=<generated-secret>
