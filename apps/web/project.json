{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": { "outputPath": "dist/apps/web" },
      "configurations": { "development": {}, "production": {} }
    },
    "serve": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": { "buildTarget": "web:build", "dev": true },
      "configurations": {
        "development": { "buildTarget": "web:build:development", "dev": true },
        "production": { "buildTarget": "web:build:production", "dev": false }
      }
    },
    "lint": { "executor": "@nx/eslint:lint" }
  },
  "tags": ["scope:web", "type:app"]
}
